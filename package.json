{
  "name": "@roidmc/horizon-ui",
  "version": "0.0.1-Alpha",
  "description": "RoidMC Horizon UI",
  "license": "MPL-2.0",
  "type": "module",
  "author": {
    "name": "RoidMC Studios",
    "email": "hi@roidmc.com",
    "url": "https://www.roidmc.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roidmc/horizon-ui.git"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./unstyled": {
      "types": "./src/unstyled.ts",
      "default": "./src/unstyled.ts"
    },
    "./styles": "./src/styles/index.scss",
    "./nuxt": {
      "types": "./src/nuxt.ts",
      "default": "./src/nuxt.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build:css": "sass --load-path=src/styles --style=expanded src/styles/index.scss dist/horizon-ui.css"
  },
  "peerDependencies": {
    "reka-ui": "^2.10.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "reka-ui": "^2.11.0",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}