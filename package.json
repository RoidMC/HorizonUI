{
  "name": "@roidmc/horizon-ui",
  "version": "0.0.1-Alpha",
  "description": "RoidMC Horizon UI",
  "license": "MPL-2.0",
  "type": "module",
  "author": {
    "name": "RoidMC Studios",
    "email": "hi@roidmc.com",
    "url": "https://www.roidmc.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/roidmc/horizon-ui"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./unstyled": "./src/unstyled.ts",
    "./styles": "./src/styles/index.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build:css": "sass --load-path=src/styles --style=expanded src/styles/index.scss dist/horizon-ui.css"
  },
  "peerDependencies": {
    "reka-ui": "^2.10.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "reka-ui": "^2.10.5",
    "sass": "^1.105.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}